# Copy to ${KB_DATA_DIR}/.env (default ~/.local/share/knowledge-base/.env) and
# fill in. The server reads that file, never the working directory's.
#
# `.env` is a LOCAL-environment convenience: it pre-seeds os.environ so the
# `${secret:...}` resolver in the YAML config can find values. It is not a
# separate config tier. A real environment variable wins over the file.

# Knowledge Base embeddings. OPEN_AI_API_KEY is needed by every write (store,
# update) and `search` when the active embedder is an OpenAI model.
# KB_EMBEDDER picks the active embedder block in knowledge_base.yaml
# (embeddings.embedders); a new model writes to its own collection.
# KB_EMBEDDER=bge-m3 uses a TEI you run yourself at http://localhost:8080/v1
# (no OpenAI key). Steps: packages/knowledge-base/README.md.
OPEN_AI_API_KEY=
KB_EMBEDDER=openai-large
