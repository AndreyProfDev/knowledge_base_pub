# Copy to .env and fill in. `.env` is gitignored.
#
# `.env` is a LOCAL-environment convenience: it pre-seeds os.environ so the
# `${secret:...}` resolver in the YAML config can find values. It is not a
# separate config tier, and it is never read when TOOLS_ENV=prod (which is what
# the Docker image sets — Compose injects these same names via `env_file:`).

# Knowledge Base embeddings. OPEN_AI_API_KEY is needed by every write (store,
# update), the worker and `search` when the active embedder is an OpenAI
# model. KB_EMBEDDER picks the active embedder block in knowledge_base.yaml
# (embeddings.embedders); a new model writes to its own collection.
# KB_EMBEDDER=bge-m3 uses the local TEI `embeddings` service (needs an NVIDIA
# GPU; no OpenAI key): `docker compose --profile gpu up -d embeddings` first,
# since `make serve` does not start it. Steps: packages/knowledge-base/README.md.
OPEN_AI_API_KEY=
KB_EMBEDDER=openai-small

# Optional AG Grid Enterprise key, baked into the knowledge-ui bundle at build
# time (client-side by design). Empty runs the grid as an unlicensed trial.
VITE_AG_GRID_LICENSE_KEY=
