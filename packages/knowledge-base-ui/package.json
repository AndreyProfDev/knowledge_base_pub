{
  "name": "knowledge-base-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../knowledge-base-api/openapi.json -o src/api/schema.d.ts && tsr generate",
    "prelint": "npm run generate",
    "lint": "eslint . && prettier --check .",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate",
    "test": "LC_ALL=de_DE.UTF-8 vitest run",
    "precoverage": "npm run generate",
    "coverage": "LC_ALL=de_DE.UTF-8 vitest run --coverage",
    "prebuild": "npm run generate",
    "build": "vite build",
    "premutate": "npm run generate",
    "mutate": "LC_ALL=de_DE.UTF-8 stryker run",
    "e2e": "playwright test",
    "dev": "vite"
  },
  "dependencies": {
    "@rjsf/core": "~6.11.0",
    "@rjsf/shadcn": "~6.11.0",
    "@rjsf/utils": "~6.11.0",
    "@rjsf/validator-ajv8": "~6.11.0",
    "@tanstack/react-query": "~5.104.3",
    "@tanstack/react-router": "~1.170.44",
    "ag-grid-community": "~36.2.0",
    "ag-grid-enterprise": "~36.2.0",
    "ag-grid-react": "~36.2.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "date-fns": "~4.4.0",
    "lucide-react": "~1.58.0",
    "openapi-fetch": "~0.17.0",
    "openapi-react-query": "~0.5.4",
    "radix-ui": "~1.8.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "sonner": "~2.0.8",
    "tailwind-merge": "~3.7.0",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@eslint-react/eslint-plugin": "~5.28.0",
    "@playwright/test": "~1.64.1",
    "@size-limit/file": "~14.2.0",
    "@stryker-mutator/core": "~10.0.0",
    "@stryker-mutator/vitest-runner": "~10.0.0",
    "@tailwindcss/vite": "~4.3.3",
    "@tanstack/eslint-plugin-query": "~5.104.3",
    "@tanstack/eslint-plugin-router": "~1.162.0",
    "@tanstack/router-cli": "~1.167.44",
    "@tanstack/router-plugin": "~1.168.46",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "@vitest/coverage-v8": "~5.0.5",
    "eslint": "~10.12.0",
    "eslint-plugin-jsdoc": "~65.3.6",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-simple-import-sort": "~14.0.0",
    "eslint-plugin-sonarjs": "~4.2.2",
    "jsdom": "~30.1.3",
    "knip": "~6.41.0",
    "openapi-typescript": "~7.13.0",
    "prettier": "~3.9.10",
    "shadcn": "~4.21.5",
    "size-limit": "~14.2.0",
    "tailwindcss": "~4.3.3",
    "tw-animate-css": "~1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.71.2",
    "vite": "~8.3.4",
    "vitest": "~5.0.5"
  }
}
